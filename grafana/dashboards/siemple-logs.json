{
  "uid": "siemple-logs",
  "title": "SIEMple logs",
  "description": "SIEMple's own logs and the events sent to POST /api/ingest. Filter by service, source, level and text at the top.",
  "tags": ["siemple", "logs"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "siemple-backend: the API's own logs. ingest: events sent with an ingest key.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "siemple-loki" },
        "query": { "type": 1, "label": "service", "stream": "", "refId": "service" },
        "definition": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "source",
        "label": "Source",
        "description": "The ingest key's name. The API's own logs have none, so they show under All.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "siemple-loki" },
        "query": {
          "type": 1,
          "label": "source",
          "stream": "{service=\"ingest\"}",
          "refId": "source"
        },
        "definition": "label_values({service=\"ingest\"}, source)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "fatal,error,warn,info,debug,trace",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "search",
        "label": "Text contains",
        "description": "Only lines containing this text (case sensitive). Empty: all lines.",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines by level",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "siemple-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "siemple-loki" },
          "expr": "sum by (level) (count_over_time({service=~\"$service\", source=~\"$source\", level=~\"$level\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fatal" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          },
          {
            "matcher": { "id": "byName", "options": "trace" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors",
      "description": "error and fatal lines in the selected time range.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "siemple-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "siemple-loki" },
          "expr": "sum(count_over_time({service=~\"$service\", source=~\"$source\", level=~\"error|fatal\"} |= \"$search\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings",
      "description": "warn lines in the selected time range.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "loki", "uid": "siemple-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "siemple-loki" },
          "expr": "sum(count_over_time({service=~\"$service\", source=~\"$source\", level=\"warn\"} |= \"$search\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingested events by source",
      "description": "Events sent to POST /api/ingest, per ingest key.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "siemple-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "siemple-loki" },
          "expr": "sum by (source) (count_over_time({service=\"ingest\", source=~\"$source\", level=~\"$level\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{source}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "description": "Newest first. Click a line for its fields; request_id matches the API's log line for that request.",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "siemple-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "siemple-loki" },
          "expr": "{service=~\"$service\", source=~\"$source\", level=~\"$level\"} |= \"$search\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
