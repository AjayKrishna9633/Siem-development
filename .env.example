# SIEMple settings for docker-compose.yml. The installer creates .env from this file and fills
# in the secrets; to set it up by hand, copy it to .env and fill in the Required section.
# Never commit .env.
#
# Generate each secret with:  openssl rand -hex 32
# Use letters and digits only for passwords: they are placed inside connection URLs.
# Values left empty fall back to the default shown in the comment.

# ── Required ────────────────────────────────────────────────────────────────
# Compose refuses to start while any of these is empty.

# Database password (the database is never exposed outside Docker).
POSTGRES_PASSWORD=
# Redis password.
REDIS_PASSWORD=
# Signs login tokens. At least 32 characters; changing it signs everyone out.
JWT_SECRET=
# Password for Grafana (the log viewer at <APP_URL>/grafana/), user GRAFANA_ADMIN_USER. Used only
# on Grafana's first start; after that, change it inside Grafana.
GRAFANA_ADMIN_PASSWORD=

# ── Address ─────────────────────────────────────────────────────────────────

# The address people open SIEMple at, e.g. http://192.168.1.20 or https://siem.example.com.
# Starting with https:// makes login cookies Secure, so only use https:// when SIEMple really is
# served over HTTPS. Default: http://localhost
APP_URL=
# Port SIEMple listens on in plain HTTP mode. Default: 80
WEB_PORT=
# Network interface for WEB_PORT. 0.0.0.0 = every interface; 127.0.0.1 = this machine only.
# Default: 0.0.0.0
WEB_BIND=

# ── HTTPS (optional) ────────────────────────────────────────────────────────
# Caddy gets a free Let's Encrypt certificate for DOMAIN: its DNS must point at this host and
# ports 80 and 443 must be reachable from the internet. To turn HTTPS on, set all of:
#   COMPOSE_PROFILES=https
#   DOMAIN=siem.example.com
#   APP_URL=https://siem.example.com
#   TRUSTED_PROXY=caddy          (nginx then takes the client IP from Caddy only)
#   WEB_BIND=127.0.0.1           (Caddy now owns ports 80/443; web stays reachable locally)
#   WEB_PORT=8080
#   GRAFANA_COOKIE_SECURE=true  (Grafana's sign-in cookie is then sent over HTTPS only)
COMPOSE_PROFILES=
DOMAIN=
TRUSTED_PROXY=
GRAFANA_COOKIE_SECURE=

# ── Version ─────────────────────────────────────────────────────────────────

# Image tag to run, e.g. 1.2.0. `latest` follows every release; pin a version to upgrade only
# when you choose to. Default: latest
SIEMPLE_VERSION=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without SMTP_HOST, invite and password-reset links are shown to the admin to pass on by hand.

SMTP_HOST=
# 587 = STARTTLS, 465 = implicit TLS. Default: 587
SMTP_PORT=
# true for implicit TLS. Default: true on port 465, otherwise false
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# e.g. "SIEMple <siem@example.com>". Default: SMTP_USER
SMTP_FROM=

# ── Advanced ────────────────────────────────────────────────────────────────

# How long logs are kept in Loki before they are deleted, in hours (h). Default: 720h (30 days)
LOKI_RETENTION=
# Grafana's admin user name, used only on its first start. Default: admin
GRAFANA_ADMIN_USER=

# fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=
# Database user and name. Only change these before the first start: the database is created with
# them. Default: siemple
POSTGRES_USER=
POSTGRES_DB=
# Image names, for a mirror or your own builds.
# Defaults: ghcr.io/ajaykrishna9633/siemple-api and ghcr.io/ajaykrishna9633/siemple-web
SIEMPLE_API_IMAGE=
SIEMPLE_WEB_IMAGE=
