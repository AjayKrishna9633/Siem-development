# SIEMple settings for docker-compose.yml. The installer creates .env from this file and fills
# in the secrets; to set it up by hand, copy it to .env and fill in the Required section.
# Never commit .env.
#
# Generate each secret with:  openssl rand -hex 32
# Use letters and digits only for passwords: they are placed inside connection URLs.
# The two Wazuh passwords below are the exception (see their comments).
# Values left empty fall back to the default shown in the comment.

# ── Required ────────────────────────────────────────────────────────────────
# Compose refuses to start while any of these is empty.

# Database password (the database is never exposed outside Docker).
POSTGRES_PASSWORD=
# Redis password.
REDIS_PASSWORD=
# Signs login tokens. At least 32 characters; changing it signs everyone out.
JWT_SECRET=
# Password for Grafana (SIEMple's health view at <APP_URL>/grafana/), user GRAFANA_ADMIN_USER. Used only
# on Grafana's first start; after that, change it inside Grafana.
GRAFANA_ADMIN_PASSWORD=
# Password for SIEMple's Wazuh API user (WAZUH_API_USER). 8 to 64 characters with an uppercase
# and a lowercase letter, a digit and one of - _ . : @ + = ! # , (Wazuh refuses to start otherwise).
WAZUH_API_PASSWORD=
# Agents present this when they enroll; it is part of the command SIEMple generates.
# 20 to 128 characters: letters, digits and - _ . : @ + = ! # , (safe inside shell quotes).
WAZUH_ENROLLMENT_PASSWORD=
# Password of siemple_enroll, the database role the enrollment service connects as. 24 to 128
# letters, digits, - or _ (it goes into a connection URL): openssl rand -hex 24
ENROLL_DB_PASSWORD=
# Encrypts the Wazuh keys of agents waiting on an enrollment link; shared only by the API and the
# enrollment service. The installer generates it; by hand: openssl rand -base64 32
# Changing it makes pending links fail (make new ones); connected agents are unaffected.
ENROLL_KEY_SECRET=

# ── Agents ──────────────────────────────────────────────────────────────────

# The address agents use to reach this server (IP or DNS name), e.g. 192.168.1.20. Agents need
# TCP 1514 and 1515 on it. Until it is set, Agents > Add agent explains how to set it.
WAZUH_PUBLIC_ADDRESS=

# ── Address ─────────────────────────────────────────────────────────────────

# The address people open SIEMple at, e.g. http://192.168.1.20 or https://siem.example.com.
# Starting with https:// makes login cookies Secure, so only use https:// when SIEMple really is
# served over HTTPS. Default: http://localhost
APP_URL=
# Port SIEMple listens on in plain HTTP mode. Default: 80
WEB_PORT=
# Network interface for WEB_PORT. 0.0.0.0 = every interface; 127.0.0.1 = this machine only.
# Default: 0.0.0.0
WEB_BIND=

# ── HTTPS (optional) ────────────────────────────────────────────────────────
# Caddy gets a free Let's Encrypt certificate for DOMAIN: its DNS must point at this host and
# ports 80 and 443 must be reachable from the internet. To turn HTTPS on, set all of:
#   COMPOSE_PROFILES=https
#   DOMAIN=siem.example.com
#   APP_URL=https://siem.example.com
#   TRUSTED_PROXY=caddy          (nginx then takes the client IP from Caddy only)
#   WEB_BIND=127.0.0.1           (Caddy now owns ports 80/443; web stays reachable locally)
#   WEB_PORT=8080
#   GRAFANA_COOKIE_SECURE=true  (Grafana's sign-in cookie is then sent over HTTPS only)
COMPOSE_PROFILES=
DOMAIN=
TRUSTED_PROXY=
GRAFANA_COOKIE_SECURE=

# ── Version ─────────────────────────────────────────────────────────────────

# Image tag to run, e.g. 1.2.0. `latest` follows every release; pin a version to upgrade only
# when you choose to. Default: latest
SIEMPLE_VERSION=

# ── Email (optional) ────────────────────────────────────────────────────────
# Easiest: leave these empty and set email up in SIEMple under Settings → Email. Setting SMTP_HOST
# here instead makes email read-only in the UI. Without either, invite and password-reset links
# are shown to the admin to pass on by hand.

# Encrypts the SMTP password saved in Settings → Email. The installer generates it; by hand:
#   openssl rand -base64 32
# Don't change it once set: the saved SMTP password would have to be entered again.
SETTINGS_ENCRYPTION_KEY=

SMTP_HOST=
# 587 = STARTTLS, 465 = implicit TLS. Default: 587
SMTP_PORT=
# true for implicit TLS. Default: true on port 465, otherwise false
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# e.g. "SIEMple <siem@example.com>". Default: SMTP_USER
SMTP_FROM=

# ── Advanced ────────────────────────────────────────────────────────────────

# Agent version to install when the Wazuh manager doesn't report its own (it normally does, and
# an agent is never newer than the manager). Default: 4.14.10
WAZUH_AGENT_VERSION=
# SIEMple's user on the Wazuh API. Default: siemple-api
WAZUH_API_USER=
# true skips checking the Wazuh API's certificate. Leave it false: SIEMple verifies the manager
# against a CA the manager creates on first start. Default: false
WAZUH_API_TLS_INSECURE=

# How long SIEMple's own container logs are kept in Loki before they are deleted, in hours (h).
# Default: 336h (14 days)
LOKI_RETENTION=
# The Docker socket the read-only API proxy (for Alloy) connects to. Change it only for rootless
# Docker, e.g. /run/user/1000/docker.sock. Default: /var/run/docker.sock
DOCKER_SOCKET=
# The env label on every log line in Grafana. Default: production
SIEMPLE_ENV=
# Grafana's admin user name, used only on its first start. Default: admin
GRAFANA_ADMIN_USER=

# fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=
# Database user and name. Only change these before the first start: the database is created with
# them. Default: siemple
POSTGRES_USER=
POSTGRES_DB=
# Where agents open enrollment links. Default: https://<WAZUH_PUBLIC_ADDRESS>:8443. Set it when
# agent machines reach this server by another name or address (DNS, NAT).
ENROLL_PUBLIC_URL=
# Image names, for a mirror or your own builds. Defaults: ghcr.io/ajaykrishna9633/siemple-api,
# ghcr.io/ajaykrishna9633/siemple-web and ghcr.io/ajaykrishna9633/siemple-enroll
SIEMPLE_API_IMAGE=
SIEMPLE_WEB_IMAGE=
SIEMPLE_ENROLL_IMAGE=
