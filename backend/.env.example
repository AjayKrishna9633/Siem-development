# SIEMple backend configuration. Copy to .env and fill in.
# Validated at startup (src/config/env.config.ts): a missing or malformed required value
# stops the server with a message naming it.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://siemple:change-me@localhost:5432/siemple
# At least 32 characters. Signs access tokens; changing it signs everyone out.
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://127.0.0.1:6379

# ── Optional ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# The browser origin allowed to call the API (CORS)
FRONTEND_URL=http://localhost:5173

# Logs go to stdout as one JSON object per line (readable coloured lines when
# NODE_ENV=development). fatal | error | warn | info | debug | trace | silent; default info.
LOG_LEVEL=

# Behind a reverse proxy (nginx, Traefik, ...), so client IPs in the audit log and rate
# limits are real: true, a hop count like 1, or addresses like loopback or 10.0.0.0/8.
# Leave empty when clients connect directly.
TRUST_PROXY=

# Email. All optional: without SMTP_HOST, invite and reset links are shown to the admin
# to pass on by hand, and "forgot password" sends nothing.
SMTP_HOST=
# 587 = STARTTLS, 465 = implicit TLS (SMTP_SECURE then defaults to true)
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER, e.g. "SIEMple <siem@acme.com>"
SMTP_FROM=

# Integration tests only: a separate, disposable database. Its schema is dropped and
# rebuilt on every test run; it must not be DATABASE_URL.
TEST_DATABASE_URL=
